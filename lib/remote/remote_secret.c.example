#include "remote_secret.h"

#include <stdio.h>
#include <string.h>

/* Copiaza ca lib/remote/remote_secret.c si completeaza valorile locale. */

static const char *HOST     = "example.com";
static const char *OTA_PATH = "/ota-xxxxx";
static const char *PULL_PATH = "/ota-xxxxx/messages.json";
static const char *MQTT_USER = "user";
static const char *MQTT_PASS = "pass";
static const uint16_t MQTT_PORT = 8883;

size_t rsec_host(char *out, size_t len)
{
    if (out == NULL || len == 0) {
        return 0;
    }
    return (size_t)snprintf(out, len, "%s", HOST);
}

uint16_t rsec_mqtt_port(void)
{
    return MQTT_PORT;
}

size_t rsec_mqtt_user(char *out, size_t len)
{
    if (out == NULL || len == 0) {
        return 0;
    }
    return (size_t)snprintf(out, len, "%s", MQTT_USER);
}

size_t rsec_mqtt_pass(char *out, size_t len)
{
    if (out == NULL || len == 0) {
        return 0;
    }
    return (size_t)snprintf(out, len, "%s", MQTT_PASS);
}

size_t rsec_ota_base(char *out, size_t len)
{
    if (out == NULL || len == 0) {
        return 0;
    }
    return (size_t)snprintf(out, len, "https://%s%s", HOST, OTA_PATH);
}

size_t rsec_pull_url(char *out, size_t len)
{
    if (out == NULL || len == 0) {
        return 0;
    }
    return (size_t)snprintf(out, len, "https://%s%s", HOST, PULL_PATH);
}
